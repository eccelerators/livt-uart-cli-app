namespace Livt.App

using Eccelerators.Cli
using Livt.IO

/**
 * Statically synthesized commands supported by the application.
 */
enum AppCommand
{
	Help
	Hello
	Bye
	Echo
	Unknown
}

/**
 * UART transport adapter and example application for Eccelerators.Cli.
 */
component UartCliApp
{
	// Buffered byte transport and the transport-independent command processor.
	uart: BufferedUart
	cli: Cli

	/**
	 * Creates the UART, reusable CLI core, and application command dispatcher.
	 */
	new(rx: in logic, tx: out logic)
	{
		this.uart = new BufferedUart(rx, tx)
		this.cli = new Cli(true)
	}

	/**
	 * Services prompts, commands, UART output, and UART input with backpressure.
	 */
	process Main()
	{
		this.cli.Service()

		if (this.cli.HasCommand() == true) {
			var dispatched: bool = this.DispatchCommand()

			if (dispatched == true) {
				this.cli.CompleteCommand()
			}
		}

		if (this.cli.HasOutput() == true) {
			var outputByte: byte = this.cli.PeekOutput()

			if (this.uart.TryTransmit(outputByte) == true) {
				this.cli.ConsumeOutput()
			}
		}

		// This process is the only CLI input owner, so capacity remains available
		// between the check and delivery of a successfully removed UART byte.
		if (this.cli.CanAcceptByte() == true) {
			var inputByte: byte

			if (this.uart.TryReceive(inputByte) == true) {
				this.cli.AcceptByte(inputByte)
			}
		}
	}

	/**
	 * Maps the pending command to exactly one application command value.
	 */
	fn ClassifyCommand() AppCommand
	{
		var help = "help".Encode()
		if (this.cli.CommandEquals(help) == true) {
			return AppCommand.Help
		}

		var hello = "hello".Encode()
		if (this.cli.CommandEquals(hello) == true) {
			return AppCommand.Hello
		}

		var bye = "bye".Encode()
		if (this.cli.CommandEquals(bye) == true) {
			return AppCommand.Bye
		}

		var echo = "echo".Encode()
		if (this.cli.CommandEquals(echo) == true) {
			return AppCommand.Echo
		}

		return AppCommand.Unknown
	}

	/**
	 * Executes the pending command; returns true when its response was written.
	 * The exhaustive match handles every AppCommand member: adding a new command
	 * makes an incomplete dispatch visible at compile time.
	 */
	fn DispatchCommand() bool
	{
		var command = ClassifyCommand()

		match command
		{
			AppCommand.Help =>
			{
				var helpMessage = "help hello bye echo".Encode()
				return cli.TryWriteLine(helpMessage)
			}
			AppCommand.Hello =>
			{
				var helloMessage = "Hello".Encode()
				return cli.TryWriteLine(helloMessage)
			}
			AppCommand.Bye =>
			{
				var byeMessage = "Bye".Encode()
				return cli.TryWriteLine(byeMessage)
			}
			AppCommand.Echo =>
			{
				return cli.TryWriteArgumentsLine()
			}
			AppCommand.Unknown =>
			{
				var unknownMessage = "Unknown command".Encode()
				return cli.TryWriteLine(unknownMessage)
			}
		}
	}
}
