namespace Livt.App

using Livt.Collections
using Livt.IO

component CommandParser
{
	const COMMAND_BUFFER_SIZE: int = 32

	const NEW_LINE: byte = 0x0A

	const CARRIAGE_RETURN: byte = 0x0D

	command_buffer: logic[32, 8]

	command_len: int

	byeCommand: ByeCommand

	helpCommand: HelpCommand

	helloCommand: HelloCommand

	unknownCommand: UnknownCommand

	uart: Uart

	new(uart: Uart)
	{
		this.uart = uart

		command_len = 0
		this.helpCommand = new HelpCommand(this.uart)
		this.helloCommand = new HelloCommand(this.uart)
		this.byeCommand = new ByeCommand(this.uart)
		this.unknownCommand = new UnknownCommand(this.uart)
	}

	public fn Parse(queue: Queue) CommandInterface
	{
		command_len = 0

		for (var i = 0; i < COMMAND_BUFFER_SIZE; i++)
		{
			if (queue.IsEmpty()) { break }
			var b = queue.Dequeue()
			this.command_buffer[command_len] = b
			command_len = command_len + 1
		}

		if(IsHelpCommand()) {
			return helpCommand
		}
		if(IsHelloCommand()) {
			return helloCommand
		}
		if(IsByeCommand()) {
			return byeCommand
		}
		return unknownCommand
	}

	fn IsHelpCommand() bool
	{
		return command_len == 4
			&& command_buffer[0] == 0x68
			&& command_buffer[1] == 0x65
			&& command_buffer[2] == 0x6C
			&& command_buffer[3] == 0x70
	}

	fn IsHelloCommand() bool
	{
		return command_len == 5
			&& command_buffer[0] == 0x68
			&& command_buffer[1] == 0x65
			&& command_buffer[2] == 0x6C
			&& command_buffer[3] == 0x6C
			&& command_buffer[4] == 0x6F
	}

	fn IsByeCommand() bool
	{
		return command_len == 3
			&& command_buffer[0] == 0x62
			&& command_buffer[1] == 0x79
			&& command_buffer[2] == 0x65
	}
}
