namespace Livt.App

using Eccelerators.Cli

/**
 * Handles bye using the caller's CLI, without owning its lifecycle.
 */
component ByeCommand : ICommand
{
	// Borrowed parser and output queue, serialized by the dispatcher.
	cli: Cli

	new(cli: Cli)
	{
		this.cli = cli
	}

	override fn Matches() bool
	{
		return this.cli.CommandEquals("bye".Encode())
	}

	override fn TryExecute() bool
	{
		return this.cli.TryWriteLine("Bye".Encode())
	}
}
