namespace Livt.App

using Eccelerators.Cli

/**
 * Handles help using the caller's CLI, without owning its lifecycle.
 */
component HelpCommand : ICommand
{
	// Borrowed parser and output queue, serialized by the dispatcher.
	cli: Cli

	new(cli: Cli)
	{
		this.cli = cli
	}

	override fn Matches() bool
	{
		return this.cli.CommandEquals("help".Encode())
	}

	override fn TryExecute() bool
	{
		return this.cli.TryWriteLine("help hello bye echo".Encode())
	}
}
