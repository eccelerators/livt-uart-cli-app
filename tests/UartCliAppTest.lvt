namespace Livt.App.Tests

using Livt.App
using Livt.IO

/**
 * Pin-level smoke test: initial prompt, echo, response and a second command.
 * Detailed parsing and command behavior are covered by byte-level tests.
 */
@Test
@Context(ClockFrequency = 100MHz)
component UartCliAppTest
{
	// Faster serial simulation; the application's default remains 115200 Hz.
	const TEST_BAUD: Frequency = 1MHz
	const POLL_TICKS: int = 100
	const MAX_RECEIVE_POLLS: int = 256

	// Application and independent serial peer use the same explicit test baud rate.
	app: UartCliApp<TEST_BAUD>
	uartTester: BufferedUart<32, 8, UartDataBits.Eight, UartParity.None, UartStopBits.One, TEST_BAUD>

	// Cross-connected serial wires; no direct access to application CLI state.
	rx: logic
	tx: logic

	new()
	{
		this.app = new UartCliApp<TEST_BAUD>(this.rx, this.tx)
		this.uartTester = new BufferedUart<32, 8, UartDataBits.Eight, UartParity.None,
			UartStopBits.One, TEST_BAUD>(this.tx, this.rx)
	}

	/**
	 * Both smoke-test commands fit the peer's eight-byte transmit queue.
	 */
	fn Transmit(data: byte[])
	{
		for (var index = 0; index < data.Length; index++) {
			assert this.uartTester.TryTransmit(data[index])
		}
	}

	/**
	 * Consumes a byte as soon as it arrives. Polling is bounded so missing output
	 * fails instead of hanging; the budget includes application processing time.
	 */
	fn ExpectByte(expected: byte)
	{
		for (var attempt = 0; attempt < MAX_RECEIVE_POLLS; attempt++) {
			var received: byte

			if (this.uartTester.TryReceive(received)) {
				assert received == expected
				return
			}

			Simulation.Wait(POLL_TICKS)
		}

		assert false, "Timed out waiting for application UART output"
	}

	fn Expect(data: byte[])
	{
		for (var index = 0; index < data.Length; index++) {
			this.ExpectByte(data[index])
		}
	}

	@Test
	fn ExchangesTwoCommandsAtTestBaudRate()
	{
		this.Expect("> ".Encode())
		this.Transmit("hello\n".Encode())
		this.Expect("hello\r\nHello\r\n> ".Encode())
		this.Transmit("bye\n".Encode())
		this.Expect("bye\r\nBye\r\n> ".Encode())

		// Two 8-N-1 frames at 1 MHz / 100 MHz expose trailing duplicate output.
		Simulation.Wait(2000)
		var remaining: byte
		assert !this.uartTester.TryReceive(remaining)
		assert remaining == 0x00
		assert this.uartTester.IsTransmitIdle()
		assert this.uartTester.GetFrameErrorCount() == 0
		assert this.uartTester.GetReceiveOverflowCount() == 0
	}
}
