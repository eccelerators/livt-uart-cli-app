namespace Livt.App.Tests

using Livt.App
using Livt.IO

@Test
component UartCliAppTest
{
	app: UartCliApp

	uartTester: BufferedUart

	rx: logic

	tx: logic

	/**
	 * Creates the application and a UART peer connected in a loop.
	 */
	new()
	{
		this.app = new UartCliApp(this.rx, this.tx)
		this.uartTester = new BufferedUart(this.tx, this.rx)
	}

	/**
	 * Queues every byte in a test message for transmission to the application.
	 */
	fn Transmit(data: byte[])
	{
		for (var i = 0; i < data.Length(); i++) {
			assert this.uartTester.Transmit(data[i]) == true
		}
	}

	/**
	 * Verifies and consumes every byte in an expected application message.
	 */
	fn Expect(data: byte[])
	{
		for (var i = 0; i < data.Length(); i++) {
			assert this.uartTester.IsDataAvailable() == true
			assert this.uartTester.Receive() == data[i]
		}
	}

	/**
	 * Verifies and consumes one expected application byte.
	 */
	fn ExpectByte(value: byte)
	{
		assert this.uartTester.IsDataAvailable() == true
		assert this.uartTester.Receive() == value
	}

	/**
	 * Waits long enough to transmit, execute, and receive a bounded CLI exchange.
	 */
	fn WaitForExchange(byteCount: int)
	{
		Simulation.Wait(UartTransmitter.TICKS_PER_BIT * 12 * byteCount)
	}

	@Test
	fn RunsCompleteInteractiveSession()
	{
		this.WaitForExchange(4)
		var prompt = "> ".Encode()
		this.Expect(prompt)
		var hello = "hello\n".Encode()
		this.Transmit(hello)
		this.WaitForExchange(24)
		var helloExchange = "hello\r\nHello\r\n> ".Encode()
		this.Expect(helloExchange)
		var help = "help\n".Encode()
		this.Transmit(help)
		this.WaitForExchange(36)
		var helpExchange = "help\r\nhelp hello bye echo\r\n> ".Encode()
		this.Expect(helpExchange)
		var echo = "echo one two\n".Encode()
		this.Transmit(echo)
		this.WaitForExchange(36)
		var echoExchange = "echo one two\r\none two\r\n> ".Encode()
		this.Expect(echoExchange)
		var tooMany = "echo 1 2 3 4 5 6 7 8 9\n".Encode()
		this.Transmit(tooMany)
		this.WaitForExchange(64)
		var tooManyExchange = "echo 1 2 3 4 5 6 7 8 9\r\nError: too many arguments\r\n> ".Encode()
		this.Expect(tooManyExchange)
		assert this.uartTester.Transmit(0x68) == true
		assert this.uartTester.Transmit(0x65) == true
		assert this.uartTester.Transmit(0x6C) == true
		assert this.uartTester.Transmit(0x6C) == true
		assert this.uartTester.Transmit(0x70) == true
		assert this.uartTester.Transmit(0x08) == true
		assert this.uartTester.Transmit(0x6F) == true
		assert this.uartTester.Transmit(0x0A) == true
		this.WaitForExchange(32)
		var editedPrefix = "hellp".Encode()
		this.Expect(editedPrefix)
		this.ExpectByte(0x08)
		this.ExpectByte(0x20)
		this.ExpectByte(0x08)
		var editedSuffix = "o\r\nHello\r\n> ".Encode()
		this.Expect(editedSuffix)
		var unknown = "nope\r\n".Encode()
		this.Transmit(unknown)
		this.WaitForExchange(36)
		var unknownExchange = "nope\r\nUnknown command\r\n> ".Encode()
		this.Expect(unknownExchange)
		assert this.uartTester.IsDataAvailable() == false
	}
}
